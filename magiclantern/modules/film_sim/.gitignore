# Host-test binaries: built by `make` in se/hosttest, no extension so the
# repo-wide *.bin / *.elf patterns do not catch them.
se/hosttest/se_cam_test
se/hosttest/grade_jpeg
se/hosttest/rawdev
se/hosttest/mrawtest
se/hosttest/savechain
se/hosttest/yuvsave_test
se/hosttest/keeptest
se/hosttest/lookmatch
se/hosttest/*.o
se/hosttest/*.d

# Build output
build/

# Simulation renders and scratch images (tens of MB, regenerated by simulate_ui.py)
tools/sim/out_*/
tools/sim/*.ppm
tools/sim/*.png

# Frame dumps and slot backups copied off the camera
*.BIN
SLOT*.BIN

# Calibration output: regenerate with tools/calib/calibrate.py
modules/film_sim/tools/calib/out/
se/hosttest/bench_grade
se/hosttest/creatorwrite
se/hosttest/fujiwrite
se/hosttest/lutchk
se/hosttest/lv3d
se/hosttest/rampchk
se/hosttest/refchk
se/hosttest/tabledump
se/hosttest/tableerr
se/hosttest/springtest
se/hosttest/fs2cube
se/hosttest/frameprev
se/hosttest/framesim
se/hosttest/bench_eng
se/hosttest/bench_lv
se/hosttest/curvechk
se/hosttest/curvecmp
se/hosttest/curveband
se/hosttest/creatorwrite_ml

# macOS debug bundles: build artefacts, and the DWARF inside them is 100s of KB
se/hosttest/*.dSYM/

# PPM scratch: simulate_ui.py writes one per stock into pse_work/, ~1 MB each.
# The glob above only caught tools/sim/*.ppm, not the subdirectory.
tools/sim/*/*.ppm
tools/sim/*/*.png
